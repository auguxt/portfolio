  <script>
  (function () {
    function pad(n){ return String(n).padStart(2,'0'); }
    function updateDateTime() {
      const now = new Date();
      const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      const dateEl = document.getElementById('live-date');
      if (dateEl) dateEl.textContent = days[now.getDay()]+', '+months[now.getMonth()]+' '+now.getDate()+', '+now.getFullYear();
      const clockEl = document.getElementById('footer-clock');
      if (clockEl) clockEl.textContent = pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());
    }
    updateDateTime(); setInterval(updateDateTime, 1000);

    const quotes = [
      "Nothing kills you faster than your own mind. Don't stress over things out of control.",
      "Having someone you can call crying, and end the call laughing is a true blessing!",
      "Your \"normal\" day is someone's dream, so be thankful every day.",
      "What you see daily shapes you. Your feed trains your brain each day.",
      "You'll be alone in the most difficult times of your life. These times make you wise, mature, and fearless.",
      "When you have a heart of gold and pure intentions, you don't lose anyone — they lose you.",
      "It's on you to get you where you want to be.",
      "One day, you'll realize that your dream died because you chose comfort over effort.",
      "Some people talk to you in their free time, and some people free their time to talk to you.",
      "The most dangerous anger comes from someone with a good heart.",
      "What they hate in you is missing in them. Keep shining.",
      "No flower grows without rain, and no person grows without pain.",
      "Slow success builds character. Fast success builds ego.",
      "Your mind is a magnet. Think blessings, attract blessings.",
      "Be the change you wish to see in the world.",
      "F-E-A-R: Face Everything And Rise."
    ];
    const quoteEl = document.getElementById('quote-text');
    const quoteBand = document.getElementById('quotes-band');
    let qIdx = Math.floor(Math.random()*quotes.length), qTimer = null, qPaused = false;
    function showQuote(text){ if(!quoteEl)return; quoteEl.style.opacity=0; setTimeout(()=>{ quoteEl.textContent=text; quoteEl.style.opacity=1; },400); }
    function nextQuote(){ qIdx=(qIdx+1)%quotes.length; showQuote(quotes[qIdx]); if(!qPaused) qTimer=setTimeout(nextQuote,7000+quotes[qIdx].length*60); }
    if(quoteEl) quoteEl.style.transition='opacity 0.4s ease';
    showQuote(quotes[qIdx]);
    qTimer=setTimeout(nextQuote,7000);
    if(quoteBand){
      quoteBand.addEventListener('mouseenter',()=>{ qPaused=true; clearTimeout(qTimer); });
      quoteBand.addEventListener('mouseleave',()=>{ qPaused=false; qTimer=setTimeout(nextQuote,7000); });
    }

    const STORAGE_KEY='rpsScores_v1';
    let playerScore=0, botScore=0;
    function loadScores(){ try{ const raw=localStorage.getItem(STORAGE_KEY); if(raw){ const p=JSON.parse(raw); playerScore=p.player||0; botScore=p.bot||0; } }catch(e){} updateScoreUI(); }
    function saveScores(){ try{ localStorage.setItem(STORAGE_KEY,JSON.stringify({player:playerScore,bot:botScore})); }catch(e){} }
    function updateScoreUI(){ const el=document.getElementById('rps-score'); if(el) el.textContent='Your Score: '+playerScore+' | Bot Score: '+botScore; }
    function playRPS(p){ const c=['rock','paper','scissors']; const b=c[Math.floor(Math.random()*3)]; const r=document.getElementById('rps-result'); if(!r) return; if(p===b){ r.textContent="🤝 It's a tie!"; } else if((p==='rock'&&b==='scissors')||(p==='paper'&&b==='rock')||(p==='scissors'&&b==='paper')){ r.textContent='✅ You win! '+p+' beats '+b+'.'; playerScore++; } else { r.textContent='❌ You lose! '+b+' beats '+p+'.'; botScore++; } updateScoreUI(); saveScores(); }
    document.querySelectorAll('.rps-choice-btn').forEach(btn=>{ btn.addEventListener('click',()=>playRPS(btn.dataset.choice)); });
    const resetBtn=document.getElementById('rps-reset');
    if(resetBtn){ resetBtn.addEventListener('click',()=>{ playerScore=0; botScore=0; saveScores(); updateScoreUI(); const r=document.getElementById('rps-result'); if(r) r.textContent='Scores reset.'; }); }
    loadScores();
  })();
  </script>
